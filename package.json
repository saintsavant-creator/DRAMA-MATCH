{
  "name": "express-postgres-starter",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run migrate && npm run export:catalog && npm run export:analytics && npm run export:pageviews && (npm run gen:og || echo 'OG image generation skipped - will generate on first request')",
    "export:catalog": "node scripts/export-catalog.js",
    "export:analytics": "node scripts/export-analytics.js",
    "export:pageviews": "node scripts/export-pageviews.js",
    "migrate": "node migrate.js",
    "gen:og": "node scripts/generate-og-image.js",
    "gen:ads": "node scripts/generate-tiktok-ads.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "openai": "^4.77.0",
    "pg": "^8.11.3",
    "sharp": "^0.33.4"
  }
}
